{
  "name": "Clinic OS",
  "short_name": "Clinic OS",
  "description": "A dental clinic's patient, visit and money records.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#FFFFFF",
  "shortcuts": [
    {
      "name": "Today",
      "url": "/app",
      "icons": [{ "src": "/icons/clinic-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Walk-in",
      "url": "/app/patients/new",
      "icons": [{ "src": "/icons/clinic-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Patients",
      "url": "/app/patients",
      "icons": [{ "src": "/icons/clinic-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/app/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "photos", "accept": ["image/*"] }]
    }
  },
  "icons": [
    {
      "src": "/icons/clinic-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/clinic-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/clinic-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
