# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# test login for Playwright (also covered by .env* above; keep explicit)
.env.test.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code agent worktrees and local settings
/.claude/

# supabase cli temporary data
supabase/.temp/

# Evidence tour output (docs/BUILD_LOG.md)
/tour/out/

# Dr. Rahil's Tally exports: patient names, ages, places and clinical notes (docs/TALLY.md)
/docs/tally/
