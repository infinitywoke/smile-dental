# Supabase project (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# The only account allowed to sign in to Clinic OS
ALLOWED_EMAIL="doctor@example.com"

# Smart notes and live dictation (aistudio.google.com -> Get API key). Server only: never NEXT_PUBLIC_.
GEMINI_API_KEY="your-gemini-key"

# Optional. 'gemini' is the default; 'claude' uses ANTHROPIC_API_KEY instead.
# AI_PROVIDER="gemini"
# ANTHROPIC_API_KEY="sk-ant-..."
